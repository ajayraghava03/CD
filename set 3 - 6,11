## write recursive descent parser for the grammar S->(L)    S->a 
L->L,S   L->S ##


#include <stdio.h>

char input[100];
int pos = 0;

int S();
int L();

// S -> (L) | a
int S() {

    if (input[pos] == 'a') {
        pos++;
        return 1;
    }

    if (input[pos] == '(') {
        pos++;

        if (!L())
            return 0;

        if (input[pos] == ')') {
            pos++;
            return 1;
        }

        return 0;
    }

    return 0;
}

// L -> S (,S)*
int L() {

    if (!S())
        return 0;

    while (input[pos] == ',') {
        pos++;

        if (!S())
            return 0;
    }

    return 1;
}

int main() {

    printf("Enter the string: ");
    scanf("%99s", input);

    if (S() && input[pos] == '\0')
        printf("Valid String\n");
    else
        printf("Invalid String\n");

    return 0;
}

