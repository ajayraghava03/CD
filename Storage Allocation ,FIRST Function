C Program to Calculate FIRST Function

#include <stdio.h>

void FIRST(char ch)
{
    if (ch == 'E' || ch == 'T' || ch == 'F')
        printf("FIRST(%c) = { (, i }\n", ch);
}

int main()
{
    printf("FIRST Sets:\n");

    FIRST('E');
    FIRST('T');
    FIRST('F');

    return 0;
}


output :
FIRST(E) = { (, i }
FIRST(T) = { (, i }
FIRST(F) = { (, i }
