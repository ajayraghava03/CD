#include <stdio.h>
#include <ctype.h>

char input[100];
int pos = 0;

int E();
int T();
int F();

int match(char c) {
    if (input[pos] == c) {
        pos++;
        return 1;
    }
    return 0;
}

// E -> T E'
int E() {
    if (!T())
        return 0;

    while (match('+')) {
        if (!T())
            return 0;
    }

    return 1;
}

// T -> F T'
int T() {
    if (!F())
        return 0;

    while (match('*')) {
        if (!F())
            return 0;
    }

    return 1;
}

// F -> (E) | id
int F() {
    if (match('(')) {
        if (!E())
            return 0;

        if (!match(')'))
            return 0;

        return 1;
    }

    // id is represented by a single letter
    if (isalpha((unsigned char)input[pos])) {
        pos++;
        return 1;
    }

    return 0;
}

int main() {
    printf("Enter an expression: ");
    scanf("%99s", input);

    if (E() && input[pos] == '\0')
        printf("Valid Expression\n");
    else
        printf("Invalid Expression\n");

    return 0;
}

